# Copy to .env and change the passwords. .env is git-ignored.
DB_USER=justify
DB_PASSWORD=change-me
POWERBI_READER_PASSWORD=change-me-too

# ollama (local, default) or groq (cloud: dummy data only until security approves)
AI_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional shared secret for server-to-server callers (X-API-Key). nginx adds it for the web app.
APP_API_KEY=
